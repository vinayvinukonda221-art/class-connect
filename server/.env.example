# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Section Configuration (Configurable Section Restriction)
ALLOWED_SECTION=21
UNIVERSITY_NAME=Vignan's Foundation for Science, Technology and Research (VFSTR)
DEPARTMENT_NAME=Computer Science and Engineering

# MongoDB Connection
# Set your MongoDB Atlas URI here. If left blank, automatic in-memory MongoDB will be used for local dev.
MONGODB_URI=

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (Student-Owned Storage via Drive API)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-drive/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file

# Initial Admin Credentials (for secure provisioning)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_this_password
INITIAL_ADMIN_ROLL=241FA00000
INITIAL_ADMIN_NAME=Admin User
INITIAL_ADMIN_PHONE=+91 0000000000

# Temporary Messages Configuration
TEMP_MESSAGE_TTL_HOURS=24

